---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'A historical overview of great jazz arrangers.', wide = false } =
  Astro.props;
const base = import.meta.env.BASE_URL;
const atDesk = Astro.url.pathname.startsWith(`${base}arranging-desk/`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#23201c" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={base}>Jazz Arrangers</a>
        <span class="tagline">a century of big band writing, 1920s–present</span>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={base} aria-current={Astro.url.pathname === base ? 'page' : undefined}>Explore arrangers</a>
          <a href={`${base}arranging-desk/`} aria-current={atDesk ? 'location' : undefined}>At the Arranging Desk</a>
        </nav>
      </div>
    </header>
    <main class:list={{ 'wide-main': wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      Educational repository of jazz arranging history ·
      <a href="https://github.com/anielsen108/Jazz-Arrangers">source on GitHub</a>
    </footer>
  </body>
</html>
