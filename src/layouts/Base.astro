---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A historical overview of 159 great jazz arrangers.' } =
  Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={base}>Jazz Arrangers</a>
        <span class="tagline">a century of big band writing, 1920s–present</span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      Educational repository of jazz arranging history ·
      <a href="https://github.com/anielsen108/Jazz-Arrangers">source on GitHub</a>
    </footer>
  </body>
</html>
