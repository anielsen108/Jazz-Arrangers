---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArrangerDashboard from '../../components/ArrangerDashboard.astro';
import {
  canonicalizeArrangers,
  eraFromArrangerId,
  lifespanLabel,
  parseArrangerHeading,
} from '../../lib/arrangers';

export async function getStaticPaths() {
  const entries = await getCollection('arrangers');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { name, born, died } = parseArrangerHeading(entry.body ?? '');
const displayName = name ?? entry.id;
const era = eraFromArrangerId(entry.id);
const siblings = canonicalizeArrangers(await getCollection('arrangers'))
  .filter((item) => eraFromArrangerId(item.id).slug === era.slug)
  .map((item) => ({ id: item.id, name: parseArrangerHeading(item.body ?? '').name ?? item.id }))
  .sort((a, b) => a.name.localeCompare(b.name));
const index = siblings.findIndex((sibling) => sibling.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : null;
const next = index < siblings.length - 1 ? siblings[index + 1] : null;
const title = `${displayName} (${lifespanLabel(born, died) || 'jazz arranger'}) — Jazz Arrangers`;
---

<Base
  title={title}
  description={`A concise visual guide to the musical style, orchestration techniques, and essential albums of ${displayName}.`}
>
  <ArrangerDashboard
    entry={entry}
    name={displayName}
    born={born}
    died={died}
    eraLabel={era.label}
    prev={prev}
    next={next}
  />
</Base>
