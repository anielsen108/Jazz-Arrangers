---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EraTabs from '../components/EraTabs.astro';
import {
  canonicalizeArrangers,
  eraFromArrangerId,
  lifespanLabel,
  parseArrangerHeading,
} from '../lib/arrangers';

const entries = await getCollection('arrangers');

const cards = canonicalizeArrangers(entries)
  .map((entry) => {
    const { name, born, died } = parseArrangerHeading(entry.body ?? '');
    return {
      id: entry.id,
      era: eraFromArrangerId(entry.id).slug,
      name: name ?? entry.id,
      years: lifespanLabel(born, died),
      photoSrc: entry.data.photo?.src,
      hasDirectListen: (entry.data.videos?.length ?? 0) > 0,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Base title="Jazz Arrangers: A Historical Overview">
  <h1>Jazz Arrangers: A Historical Overview</h1>
  <p>
    A repository documenting great jazz arrangers throughout history, from the
    first dance bands to contemporary hybrid jazz. Browse by predominant era
    below — each arranger has a visual guide to their biography,
    musical style, orchestration techniques, scores, and essential albums.
  </p>

  <div class="arranger-search">
    <label for="arranger-search">Search arrangers by name</label>
    <input
      id="arranger-search"
      type="search"
      placeholder="Start typing a name"
      autocomplete="off"
      data-arranger-search
    />
    <p class="arranger-search-status" aria-live="polite" data-arranger-search-status></p>
  </div>

  <EraTabs items={cards} />
</Base>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-arranger-search]');
  const status = document.querySelector<HTMLElement>('[data-arranger-search-status]');
  const namedItems = Array.from(document.querySelectorAll<HTMLElement>('[data-arranger-name]'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-era-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-era-panel]'));

  const activateEra = (slug: string, moveFocus = false) => {
    tabs.forEach((tab) => {
      const active = tab.dataset.eraTab === slug;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && moveFocus) tab.focus();
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.eraPanel !== slug;
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activateEra(tab.dataset.eraTab ?? ''));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const availableTabs = tabs.filter((candidate) => !candidate.hidden);
      const currentIndex = availableTabs.indexOf(tab);
      const target =
        event.key === 'Home' ? availableTabs[0]
        : event.key === 'End' ? availableTabs.at(-1)
        : availableTabs[
            (currentIndex + (event.key === 'ArrowRight' ? 1 : -1) + availableTabs.length) %
              availableTabs.length
          ];
      if (target) activateEra(target.dataset.eraTab ?? '', true);
    });
  });

  const filterArrangers = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    namedItems.forEach((item) => {
      item.hidden = Boolean(query) && !item.dataset.arrangerName?.toLocaleLowerCase().includes(query);
    });

    let matchingEras = 0;
    panels.forEach((panel) => {
      const visibleCount = panel.querySelectorAll('[data-arranger-card]:not([hidden])').length;
      const tab = tabs.find((candidate) => candidate.dataset.eraTab === panel.dataset.eraPanel);
      const count = panel.querySelector<HTMLElement>('[data-era-count]');
      if (tab) tab.hidden = Boolean(query) && visibleCount === 0;
      if (count) {
        const totalCount = panel.querySelectorAll('[data-arranger-card]').length;
        count.textContent = query
          ? `${visibleCount} matching arranger${visibleCount === 1 ? '' : 's'}`
          : `${totalCount} arrangers`;
      }
      if (visibleCount > 0) matchingEras += 1;
    });

    const visibleItems = namedItems.filter((item) => !item.hidden);
    const activeTab = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true' && !tab.hidden);
    const firstAvailable = tabs.find((tab) => !tab.hidden);
    if (activeTab) {
      activateEra(activeTab.dataset.eraTab ?? '');
    } else if (firstAvailable) {
      activateEra(firstAvailable.dataset.eraTab ?? '');
    } else {
      panels.forEach((panel) => {
        panel.hidden = true;
      });
    }

    if (status) {
      status.textContent = query && visibleItems.length === 0
        ? `No arranger found for “${search?.value.trim()}”.`
        : query
          ? `${visibleItems.length} matching arranger${visibleItems.length === 1 ? '' : 's'} across ${matchingEras} era${matchingEras === 1 ? '' : 's'}.`
          : '';
    }
  };

  search?.addEventListener('input', filterArrangers);
</script>
