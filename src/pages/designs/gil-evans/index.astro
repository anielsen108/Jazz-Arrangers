---
import Base from '../../../layouts/Base.astro';
import { gilEvansVariants } from '../../../lib/gilEvansLab';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Gil Evans — ten visual directions" description="Ten alternative page designs for the Jazz Arrangers site.">
  <div class="concept-index">
    <nav class="index-breadcrumb"><a href={`${base}/arrangers/1940s/gil-evans/`}>← Current Gil Evans page</a></nav>
    <header>
      <p>Jazz Arrangers · design lab</p>
      <h1>Ten ways to<br /><em>see</em> the music.</h1>
      <div class="index-intro">
        <p>Each concept uses the same concise content and reusable visual vocabulary. Compare the system—not the amount of copy.</p>
        <dl>
          <div><dt>Bio</dt><dd>32 words</dd></div>
          <div><dt>Style</dt><dd>5 visual dimensions</dd></div>
          <div><dt>Technique</dt><dd>6 interactive cards</dd></div>
          <div><dt>Albums</dt><dd>1 line each</dd></div>
        </dl>
      </div>
    </header>

    <ol class="concept-grid">
      {gilEvansVariants.map((variant) => (
        <li class={`concept-card concept-${variant.number}`}>
          <a href={`${base}/designs/gil-evans/${variant.slug}/`}>
            <div class="miniature" aria-hidden="true">
              <span class="mini-title">GE</span>
              <span class="mini-portrait"></span>
              <span class="mini-data"><i></i><i></i><i></i><i></i><i></i></span>
              <span class="mini-cards"><i></i><i></i><i></i></span>
            </div>
            <div class="card-copy">
              <span class="card-number">{variant.number}</span>
              <div><h2>{variant.name}</h2><p>{variant.description}</p></div>
              <span class="card-arrow">↗</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .concept-index {
    width: min(78rem, calc(100vw - 2rem));
    margin-left: 50%;
    transform: translateX(-50%);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  .index-breadcrumb { margin-bottom: 2rem; font-size: 0.75rem; }
  .index-breadcrumb a { color: var(--muted); text-decoration: none; }
  .concept-index > header { padding: clamp(2rem, 5vw, 5rem); color: #f5f2ea; background: #171b1e; border-radius: 1rem; }
  .concept-index > header > p { margin: 0 0 1.5rem; color: #ef633e; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(3.5rem, 9vw, 8rem); line-height: 0.83; letter-spacing: -0.07em; }
  h1 em { color: #ef633e; font-family: Georgia, serif; font-weight: 400; }
  .index-intro { margin-top: 4rem; display: grid; grid-template-columns: 1fr 1.4fr; gap: 3rem; align-items: end; }
  .index-intro > p { max-width: 30rem; margin: 0; color: #adb4b8; font-size: 0.9rem; }
  dl { margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #444b4f; }
  dl div { padding: 0.8rem 0.5rem 0 0; }
  dt { color: #848d91; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.08em; }
  dd { margin: 0.2rem 0 0; font-size: 0.72rem; font-weight: 750; }
  .concept-grid { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .concept-card { --card-bg: #eef1f2; --card-paper: #fff; --card-ink: #17212a; --card-accent: #e35a32; min-width: 0; }
  .concept-card > a { display: block; height: 100%; padding: 0.8rem; color: var(--card-ink); background: var(--card-bg); border: 1px solid color-mix(in srgb, var(--card-ink) 15%, transparent); border-radius: 0.7rem; text-decoration: none; transition: transform 180ms ease, box-shadow 180ms ease; }
  .concept-card > a:hover { transform: translateY(-0.4rem); box-shadow: 0 1.2rem 2.5rem rgb(20 24 28 / 0.15); }
  .miniature { height: 18rem; padding: 1.5rem; display: grid; grid-template-columns: 1.2fr 0.8fr; grid-template-rows: 1fr auto; gap: 1rem; overflow: hidden; position: relative; background: var(--card-paper); }
  .mini-title { align-self: center; color: var(--card-ink); font-size: 7rem; line-height: 0.7; font-weight: 900; letter-spacing: -0.12em; }
  .mini-portrait { background: linear-gradient(145deg, var(--card-accent), var(--card-ink)); border-radius: 7rem 7rem 0.3rem 0.3rem; opacity: 0.85; }
  .mini-data { display: flex; gap: 0.3rem; align-items: flex-end; }
  .mini-data i { width: 0.8rem; height: 3rem; background: var(--card-accent); }
  .mini-data i:nth-child(2) { height: 4.5rem; }.mini-data i:nth-child(3) { height: 2rem; }.mini-data i:nth-child(4) { height: 3.7rem; }.mini-data i:nth-child(5) { height: 2.8rem; }
  .mini-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.25rem; }
  .mini-cards i { border: 1px solid color-mix(in srgb, var(--card-ink) 25%, transparent); background: color-mix(in srgb, var(--card-accent) 10%, var(--card-paper)); }
  .card-copy { min-height: 7rem; padding: 1rem 0.5rem 0.3rem; display: grid; grid-template-columns: 2.2rem 1fr auto; gap: 0.8rem; }
  .card-number { color: var(--card-accent); font-size: 0.68rem; font-weight: 900; }
  h2 { margin: 0; color: var(--card-ink); font-size: 1.05rem; }
  .card-copy p { max-width: 27rem; margin: 0.4rem 0 0; color: color-mix(in srgb, var(--card-ink) 60%, transparent); font-size: 0.72rem; }
  .card-arrow { color: var(--card-accent); }
  .concept-02 { --card-bg: #121735; --card-paper: #171c3e; --card-ink: #f5f0dc; --card-accent: #ff6d6d; }
  .concept-02 .mini-portrait { border-radius: 50%; background: radial-gradient(circle at 35% 35%, #50d9d2, transparent 43%), #ff6d6d; }
  .concept-03 { --card-bg: #d8d0bb; --card-paper: #f4efdf; --card-ink: #27241d; --card-accent: #8a3025; }
  .concept-03 .miniature { background-image: repeating-linear-gradient(to bottom, transparent 0 18px, #d6cdb9 19px 20px); }
  .concept-04 { --card-bg: #050713; --card-paper: #090c1b; --card-ink: #eef1ff; --card-accent: #8c79ff; }
  .concept-04 .miniature { background-image: radial-gradient(circle, #8c79ff 0 1px, transparent 1.5px); background-size: 28px 28px; }
  .concept-04 .mini-portrait { clip-path: polygon(50% 0, 100% 35%, 80% 100%, 15% 85%, 0 20%); border-radius: 0; }
  .concept-05 { --card-bg: #171a18; --card-paper: #232724; --card-ink: #ecf1e8; --card-accent: #a5ef61; }
  .concept-05 .mini-data { align-items: stretch; }.concept-05 .mini-data i { height: auto; border-radius: 1rem; }
  .concept-06 { --card-bg: #082c49; --card-paper: #0c3a5c; --card-ink: #e0f6ff; --card-accent: #66e3ff; }
  .concept-06 .miniature { background-image: linear-gradient(#39708b 1px, transparent 1px), linear-gradient(90deg, #39708b 1px, transparent 1px); background-size: 1rem 1rem; }
  .concept-07 { --card-bg: #f0d6aa; --card-paper: #f7e4c2; --card-ink: #352018; --card-accent: #d95032; }
  .concept-07 .miniature { background: linear-gradient(165deg, #f7e4c2 0 58%, #e7ad72 58.5% 76%, #b65840 76.5%); }
  .concept-08 { --card-bg: #e2d2b9; --card-paper: #f2e7d2; --card-ink: #35252a; --card-accent: #9d3344; }
  .concept-08 .miniature { transform: rotate(-0.8deg); box-shadow: 0.5rem 0.6rem #9d3344; }
  .concept-09 { --card-bg: #d8d8d3; --card-paper: #f5f5f0; --card-ink: #11110f; --card-accent: #f02b1d; }
  .concept-09 .mini-title { font-size: 9rem; text-transform: uppercase; }
  .concept-10 { --card-bg: #080807; --card-paper: #11100e; --card-ink: #f4eee3; --card-accent: #d9aa56; }
  .concept-10 .miniature { background: linear-gradient(to top, #11100e, transparent), linear-gradient(135deg, #4a4439, #0a0a09); }
  @media (max-width: 50rem) {
    .concept-grid { grid-template-columns: 1fr; }
    .index-intro { grid-template-columns: 1fr; }
  }
  @media (max-width: 34rem) {
    .concept-index { width: calc(100vw - 1rem); }
    .concept-index > header { padding: 2rem 1.2rem; }
    .index-intro dl { grid-template-columns: repeat(2, 1fr); }
    .miniature { height: 14rem; }
    .mini-title { font-size: 5rem; }
  }
</style>
