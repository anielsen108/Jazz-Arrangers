---
import type { CollectionEntry } from 'astro:content';
import '../styles/gil-evans-lab.css';
import '../styles/arranger-dashboard.css';
import { INSTRUMENTS } from '../lib/ensemble';
import { lifespanLabel } from '../lib/arrangers';
import { parseArrangerProfile } from '../lib/arrangerProfile';

interface Neighbor {
  id: string;
  name: string;
}

interface Props {
  entry: CollectionEntry<'arrangers'>;
  name: string;
  born: number | null;
  died: number | null;
  decadeLabel: string;
  prev: Neighbor | null;
  next: Neighbor | null;
}

const { entry, name, born, died, decadeLabel, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const profile = parseArrangerProfile(entry.body ?? '');
const { photo, videos = [], pieces = [] } = entry.data;
const pieceSlugs = new Set(pieces.map((piece) => piece.slug));
const videosFor = (slug: string) => videos.filter((video) => video.piece === slug);
const generalVideos = videos.filter((video) => !video.piece || !pieceSlugs.has(video.piece));
const life = lifespanLabel(born, died) || 'dates unavailable';

const nameParts = name.trim().split(/\s+/);
const lastName = nameParts.length > 1 ? nameParts.pop() ?? '' : '';
const firstNames = nameParts.join(' ') || name;
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .slice(0, 2)
  .join('');

const radarCenter = 100;
const radarRadius = 72;
const pointAt = (value: number, index: number) => {
  const angle = -Math.PI / 2 + (Math.PI * 2 * index) / profile.soundDNA.length;
  const radius = radarRadius * (value / 100);
  return `${radarCenter + Math.cos(angle) * radius},${radarCenter + Math.sin(angle) * radius}`;
};
const radarPoints = profile.soundDNA.map((item, index) => pointAt(item.value, index)).join(' ');
const axisPoints = profile.soundDNA.map((_, index) => pointAt(100, index));

const familyData = (ensemble: Record<string, number>) => {
  const totals = { brass: 0, reeds: 0, rhythm: 0 };
  for (const [instrument, count] of Object.entries(ensemble)) {
    const row = INSTRUMENTS[instrument]?.row;
    if (row === 'trumpets' || row === 'low-brass') totals.brass += count;
    if (row === 'reeds') totals.reeds += count;
    if (row === 'rhythm') totals.rhythm += count;
  }
  const maximum = Math.max(1, totals.brass, totals.reeds, totals.rhythm);
  return [
    { label: 'Brass', value: totals.brass, color: 'brass' },
    { label: 'Woodwinds', value: totals.reeds, color: 'reeds' },
    { label: 'Rhythm + color', value: totals.rhythm, color: 'rhythm' },
  ].map((family) => ({ ...family, level: Math.round((family.value / maximum) * 100) }));
};

const instrumentLabels = (ensemble: Record<string, number>) =>
  Object.entries(ensemble).map(([instrument, count]) => {
    const label = INSTRUMENTS[instrument]?.label ?? instrument;
    return count > 1 ? `${count} ${label}${label.endsWith('s') ? '' : 's'}` : label;
  });
---

<nav class="dashboard-breadcrumb">
  <a href={`${base}/`}>All arrangers</a><span>›</span><span>{decadeLabel}</span>
</nav>

<div class="lab-shell production-dashboard" data-variant="01-orchestra-dashboard">
  <article class="arranger-concept">
    <header class="concept-hero">
      <div class="hero-copy">
        <p class="concept-kicker">Jazz arranging · {decadeLabel}</p>
        <h1>{firstNames}{lastName && <span>{lastName}</span>}</h1>
        <p class="lifespan">{life} <i aria-hidden="true"></i> arranger · composer · orchestrator</p>
        <p class="hero-thesis">{profile.thesis}</p>
        <div class="hero-tags" aria-label="Signature traits">
          {profile.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>

      {
        photo ? (
          <figure class="hero-portrait">
            <div class="portrait-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
            <img src={`${base}${photo.src}`} alt={`Portrait of ${name}`} />
            <figcaption>
              {photo.source ? <a href={photo.source}>{photo.credit}</a> : photo.credit} · {photo.license}
            </figcaption>
          </figure>
        ) : (
          <figure class="hero-portrait portrait-placeholder">
            <div class="portrait-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
            <span aria-hidden="true">{initials}</span>
            <figcaption>Portrait not yet available</figcaption>
          </figure>
        )
      }

      <dl class="hero-facts">
        <div><dt>Period</dt><dd>{decadeLabel}</dd></div>
        <div><dt>Lifespan</dt><dd>{life}</dd></div>
        <div><dt>Signature</dt><dd>{profile.tags[0]}</dd></div>
      </dl>
    </header>

    <section class="bio-strip" aria-labelledby="bio-title">
      <div class="section-number">00</div>
      <div>
        <p class="section-label" id="bio-title">Bio · {profile.bioWordCount} words</p>
        <p>{profile.bio}</p>
      </div>
    </section>

    <section class="dna-section" aria-labelledby="dna-title">
      <header class="section-heading">
        <div><p class="section-number">01</p><p class="section-label">Musical style</p></div>
        <h2 id="dna-title">Sound DNA</h2>
        <p>Five shared dimensions make the arranger’s musical priorities visible at a glance.</p>
      </header>

      <div class="dna-layout">
        <figure class="radar-card" aria-label={`${name} sound DNA radar chart`}>
          <svg class="radar" viewBox="0 0 200 200" role="img" aria-labelledby="radar-title radar-desc">
            <title id="radar-title">{name} sound DNA</title>
            <desc id="radar-desc">Comparative profile of color, space, register, density, and motion.</desc>
            <polygon class="radar-grid radar-grid-outer" points={axisPoints.join(' ')} />
            <polygon class="radar-grid" points={profile.soundDNA.map((_, index) => pointAt(66, index)).join(' ')} />
            <polygon class="radar-grid" points={profile.soundDNA.map((_, index) => pointAt(33, index)).join(' ')} />
            {axisPoints.map((point) => {
              const [x, y] = point.split(',');
              return <line class="radar-axis" x1="100" y1="100" x2={x} y2={y} />;
            })}
            <polygon class="radar-shape" points={radarPoints} />
            {profile.soundDNA.map((item, index) => {
              const [x, y] = pointAt(item.value, index).split(',');
              return <circle class="radar-point" cx={x} cy={y} r="3" />;
            })}
          </svg>
          <div class="radar-labels" aria-hidden="true">
            {profile.soundDNA.map((item) => <span>{item.label}</span>)}
          </div>
          <figcaption>The same scale is used throughout the collection.</figcaption>
        </figure>

        <div class="dna-cards">
          {profile.soundDNA.map((item) => (
            <article class="dna-card" style={`--dna-level:${item.value}%`}>
              <div class="dna-card-top"><span>{item.label}</span><strong>{item.value}</strong></div>
              <div class="dna-meter" aria-hidden="true"><i></i></div>
              <h3>{item.word}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="technique-section" aria-labelledby="technique-title">
      <header class="section-heading">
        <div><p class="section-number">02</p><p class="section-label">Orchestration</p></div>
        <h2 id="technique-title">Technique deck</h2>
        <p>Select a card to spotlight a device drawn from this arranger’s orchestral language.</p>
      </header>

      <div class="technique-grid" data-technique-grid>
        {profile.techniques.map((technique, index) => (
          <button
            class:list={['technique-card', { active: index === 0 }]}
            type="button"
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-technique-card
          >
            <span class="technique-index">{technique.number}</span>
            <span class={`technique-glyph glyph-${technique.glyph}`} aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            <span class="technique-title">{technique.title}</span>
            <span class="technique-description">{technique.description}</span>
            <span class="technique-cue"><i aria-hidden="true">↗</i>{technique.cue}</span>
          </button>
        ))}
      </div>
    </section>

    {pieces.length > 0 && (
      <section class="piece-section" aria-labelledby="piece-title">
        <header class="section-heading">
          <div><p class="section-number">03</p><p class="section-label">Music first</p></div>
          <h2 id="piece-title">Scores &amp; orchestras</h2>
          <p>Switch recordings to see how the ensemble changes around each musical idea.</p>
        </header>

        <div class="piece-tabs" role="tablist" aria-label="Featured scores">
          {pieces.map((piece, index) => (
            <button
              type="button"
              role="tab"
              class:list={['piece-tab', { active: index === 0 }]}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`piece-${piece.slug}`}
              id={`tab-${piece.slug}`}
              data-piece-tab={piece.slug}
            ><span>{piece.year ?? 'Score'}</span>{piece.title}</button>
          ))}
        </div>

        <div class="piece-panels">
          {pieces.map((piece, index) => {
            const families = familyData(piece.ensemble);
            const pieceVideos = videosFor(piece.slug);
            return (
              <section
                class:list={['piece-panel', { active: index === 0 }]}
                role="tabpanel"
                id={`piece-${piece.slug}`}
                aria-labelledby={`tab-${piece.slug}`}
                hidden={index !== 0}
                data-piece-panel={piece.slug}
              >
                <div class="piece-story">
                  <p class="piece-album">{piece.album}{piece.year && ` · ${piece.year}`}</p>
                  <h3>{piece.title}</h3>
                  {piece.note && <p class="piece-note">{piece.note}</p>}
                  {pieceVideos[0] && (
                    <button class="piece-listen" type="button" data-video-id={pieceVideos[0].id} data-video-title={pieceVideos[0].title}>
                      <span aria-hidden="true">▶</span> Play listening example
                    </button>
                  )}
                </div>
                <figure class="ensemble-viz">
                  <figcaption><strong>{Object.keys(piece.ensemble).length}</strong> distinct chair colors</figcaption>
                  <div class="family-bars">
                    {families.map((family) => (
                      <div class={`family-row family-${family.color}`}>
                        <span>{family.label}</span>
                        <i style={`--family-level:${family.level}%`}><b>{family.value}</b></i>
                      </div>
                    ))}
                  </div>
                  <div class="instrument-cloud" aria-label="Instrumentation">
                    {instrumentLabels(piece.ensemble).map((instrument) => <span>{instrument}</span>)}
                  </div>
                </figure>
              </section>
            );
          })}
        </div>
      </section>
    )}

    {pieces.length === 0 && (
      <section class="piece-section derived-score-section" aria-labelledby="piece-title">
        <header class="section-heading">
          <div><p class="section-number">03</p><p class="section-label">Music first</p></div>
          <h2 id="piece-title">Scores &amp; orchestras</h2>
          <p>Switch recordings to compare how this arranger’s musical priorities shape each orchestral profile.</p>
        </header>

        <div class="piece-tabs" role="tablist" aria-label="Featured scores and recordings">
          {profile.scores.map((score, index) => (
            <button
              type="button"
              role="tab"
              class:list={['piece-tab', { active: index === 0 }]}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`score-${score.slug}`}
              id={`tab-${score.slug}`}
              data-piece-tab={score.slug}
            ><span>{score.year}</span>{score.title}</button>
          ))}
        </div>

        <div class="piece-panels">
          {profile.scores.map((score, index) => (
            <section
              class:list={['piece-panel', 'derived-score-panel', { active: index === 0 }]}
              role="tabpanel"
              id={`score-${score.slug}`}
              aria-labelledby={`tab-${score.slug}`}
              hidden={index !== 0}
              data-piece-panel={score.slug}
            >
              <div class="piece-story">
                <p class="piece-album">{score.album}{score.year !== '—' && ` · ${score.year}`}</p>
                <h3>{score.title}</h3>
                <p class="piece-note">{score.note}</p>
                <p class="listen-cue"><span aria-hidden="true">◎</span><strong>Listen for</strong>{score.cue}</p>
              </div>
              <figure class="ensemble-viz">
                <figcaption>Comparative orchestral profile</figcaption>
                <div class="family-bars score-profile-bars">
                  {score.dimensions.map((dimension, dimensionIndex) => (
                    <div class={`family-row score-dimension-${dimensionIndex + 1}`}>
                      <span>{dimension.label}</span>
                      <i style={`--family-level:${dimension.value}%`}><b>{dimension.value}</b></i>
                    </div>
                  ))}
                </div>
                <div class="instrument-cloud" aria-label="Signature profile">
                  {profile.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <p class="derived-data-note">Profile derived from the arranger’s documented style and recording notes; exact instrumentation is not asserted.</p>
              </figure>
            </section>
          ))}
        </div>
      </section>
    )}

    <section class="albums-section" aria-labelledby="albums-title">
      <header class="section-heading">
        <div><p class="section-number">04</p><p class="section-label">Start here</p></div>
        <h2 id="albums-title">{profile.albums.length === 3 ? 'Three essential albums' : 'Essential albums'}</h2>
        <p>One line each—enough context to choose the next listen.</p>
      </header>
      <ol class="album-list">
        {profile.albums.map((album, index) => (
          <li>
            <span class="album-number">0{index + 1}</span>
            <span class="album-year">{album.year}</span>
            <span class="album-title"><strong>{album.title}</strong><small>{album.artist || name}</small></span>
            <span class="album-line">{album.line}</span>
            <span class="album-arrow" aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>
      {generalVideos.length > 0 && (
        <div class="general-listen">
          {generalVideos.map((video) => (
            <button class="piece-listen" type="button" data-video-id={video.id} data-video-title={video.title}>
              <span aria-hidden="true">▶</span>{video.title}
            </button>
          ))}
        </div>
      )}
    </section>

    <footer class="concept-footer">
      <span>{prev && <a href={`${base}/arrangers/${prev.id}/`}>← <b>{prev.name}</b></a>}</span>
      <a class="footer-index-link" href={`${base}/`}>All arrangers</a>
      <span>{next && <a href={`${base}/arrangers/${next.id}/`}><b>{next.name}</b> →</a>}</span>
    </footer>
  </article>
</div>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const techniqueCard = target.closest<HTMLButtonElement>('[data-technique-card]');
    if (techniqueCard) {
      const grid = techniqueCard.closest('[data-technique-grid]');
      grid?.querySelectorAll<HTMLButtonElement>('[data-technique-card]').forEach((card) => {
        const active = card === techniqueCard;
        card.classList.toggle('active', active);
        card.setAttribute('aria-pressed', String(active));
      });
    }

    const pieceTab = target.closest<HTMLButtonElement>('[data-piece-tab]');
    if (pieceTab) {
      const shell = pieceTab.closest('.piece-section');
      const slug = pieceTab.dataset.pieceTab;
      shell?.querySelectorAll<HTMLButtonElement>('[data-piece-tab]').forEach((tab) => {
        const active = tab === pieceTab;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      shell?.querySelectorAll<HTMLElement>('[data-piece-panel]').forEach((panel) => {
        const active = panel.dataset.piecePanel === slug;
        panel.classList.toggle('active', active);
        panel.hidden = !active;
      });
    }

    const listenButton = target.closest<HTMLButtonElement>('[data-video-id]');
    if (listenButton) {
      const iframe = document.createElement('iframe');
      iframe.className = 'lab-video';
      iframe.src = `https://www.youtube-nocookie.com/embed/${listenButton.dataset.videoId}?autoplay=1`;
      iframe.title = listenButton.dataset.videoTitle ?? 'Listening example';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      listenButton.replaceWith(iframe);
    }
  });
</script>
